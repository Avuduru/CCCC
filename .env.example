TMDB_KEY=your_tmdb_api_key_here
RAWG_KEY=your_rawg_api_key_here
STEAMGRIDDB_KEY=your_steamgriddb_key_here
# GOOGLE_BOOKS_KEY=your_google_books_key_here

# Set to 'local' on your dev machine to disable SSL verification and relax CORS
APP_ENV=production



# Database (MySQL — required for classification storage on production)
DB_HOST=localhost
DB_NAME=cccc_db
DB_USER=cccc_user
DB_PASS=your_strong_password_here

# Which request header holds the real visitor IP at the origin (vote dedup + rate limit).
# Ask your host which header its edge sets and guarantees to overwrite (so clients can't
# forge it), e.g. X-Real-IP. Leave unset to use the last X-Forwarded-For entry.
# TRUSTED_IP_HEADER=X-Real-IP
